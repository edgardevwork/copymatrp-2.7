<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D9171921">

    <FrameLayout
        android:id="@+id/btn_back"
        android:layout_width="@dimen/_28sdp"
        android:layout_height="@dimen/_28sdp"
        android:layout_marginTop="@dimen/_15sdp"
        android:layout_marginEnd="@dimen/_11sdp"
        android:background="@drawable/ic_dialog_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="@dimen/_11sdp"
            android:layout_height="@dimen/_11sdp"
            android:src="@drawable/ic_close"
            android:layout_gravity="center" />

    </FrameLayout>


    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/ic_dialog_nlremake"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/bigText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_18sdp"
                android:layout_marginTop="@dimen/_11sdp"
                android:layout_marginRight="@dimen/_38sdp"
                android:fontFamily="@font/geologica_bold"
                android:text="Активация промокода"
                android:textColor="@color/white"
                android:textSize="@dimen/_17sdp" />

            <TextView
                android:id="@+id/littleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_18sdp"
                android:layout_marginTop="@dimen/_2sdp"
                android:layout_marginRight="@dimen/_20sdp"
                android:fontFamily="@font/montserrat_medium"
                android:lineHeight="@dimen/_11sdp"
                android:text="Введи промокод, чтобы получить награды"
                android:textColor="#E6E9E9F3"
                android:textSize="@dimen/_8sdp" />

            <LinearLayout
                android:id="@+id/promo_layout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_28sdp"
                android:layout_marginTop="@dimen/_16sdp"
                android:layout_marginLeft="@dimen/_18sdp"
                android:layout_marginRight="@dimen/_18sdp"
                android:background="@drawable/ic_dialog_nl_input_bg"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/promo_layout_image"
                    android:layout_width="@dimen/_10sdp"
                    android:layout_height="@dimen/_10sdp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="@dimen/_12sdp"
                    app:srcCompat="@drawable/ic_promo2" />

                <EditText
                    android:id="@+id/email_layout_email_input"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/_7sdp"
                    android:layout_marginEnd="@dimen/_12sdp"
                    android:background="@null"
                    android:ellipsize="end"
                    android:fontFamily="@font/geologica_medium"
                    android:hint="Введи ромокод"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="#ffffff"
                    android:textColorHighlight="#ffffff"
                    android:textColorHint="#66ffffff"
                    android:textColorLink="#ffffff"
                    android:textSize="@dimen/_9sdp" />

            </LinearLayout>


            <TextView
                android:id="@+id/email_pass_error_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_18sdp"
                android:layout_marginTop="@dimen/_2sdp"
                android:fontFamily="@font/geologica_medium"
                android:text="Неправильный формат эл. адреса"
                android:textColor="#bc5555"
                android:visibility="gone"
                android:textSize="@dimen/_9sdp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/_14sdp"
                android:layout_marginLeft="@dimen/_18sdp"
                android:layout_marginRight="@dimen/_18sdp"
                android:visibility="visible">

                <FrameLayout
                    android:id="@+id/main_btn_yes"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_28sdp"
                    android:layout_marginBottom="@dimen/_18sdp"
                    android:background="@drawable/ic_dialog_newbtnin">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="@font/geologica_medium"
                        android:text="Активировать"
                        android:textColor="#ffffff"
                        android:textSize="@dimen/_9sdp" />
                </FrameLayout>

            </LinearLayout>
        </LinearLayout>

    </FrameLayout>


</androidx.constraintlayout.widget.ConstraintLayout>