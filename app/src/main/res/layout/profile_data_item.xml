<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="@dimen/_10sdp"
    android:layout_marginEnd="@dimen/_22sdp"
    app:layout_constraintStart_toStartOf="@+id/linearLayout4"
    app:layout_constraintTop_toBottomOf="@+id/linearLayout4">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvStatLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.4"
                android:text="Денег в банке"
                android:fontFamily="@font/geologica_regular"
                android:textColor="@color/white"
                android:textSize="@dimen/_7sdp"/>


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvStatValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4525"
                    android:fontFamily="@font/geologica_semibold"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_14sdp"/>

                <ImageView
                    android:id="@+id/ic_rub"
                    android:layout_width="@dimen/_10sdp"
                    android:layout_height="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_1sdp"
                    android:layout_marginLeft="@dimen/_3sdp"
                    android:layout_gravity="center_vertical"
                    app:srcCompat="@drawable/ic_rub" />
            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

</LinearLayout>