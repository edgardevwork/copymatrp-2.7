<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ru.edgar.nlremake.ui.FullHeightVideoView
        android:id="@+id/videoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="@dimen/_104sdp"
        android:layout_height="@dimen/_68sdp"
        app:srcCompat="@drawable/loading_logo" />

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="@dimen/_20sdp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/lm_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="@dimen/_24sdp"
            android:layout_weight="1.0"
            android:fontFamily="@font/ttnorms_medium"
            android:gravity="right"
            android:letterSpacing="0.035"
            android:text="Загрузка..."
            android:textColor="#ffffffff"
            android:textSize="@dimen/_9sdp"
            tools:ignore="SpUsage" />

        <ImageView
            android:id="@+id/lm_loadicon"
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:layout_gravity="center"
            android:layout_marginEnd="@dimen/_23sdp"
            android:background="@drawable/ic_loadingmenu_load"
            android:rotationY="180" />

    </LinearLayout>

    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_32sdp"
        android:layout_marginEnd="@dimen/_32sdp"
        android:layout_marginBottom="@dimen/_20sdp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/_6sdp">

            <TextView
                android:textSize="@dimen/_9sdp"
                android:textColor="#BABABA"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Загружено файлов"
                android:fontFamily="@font/ttnorms_medium"
                tools:ignore="SpUsage" />

            <TextView
                android:id="@+id/fail"
                android:textSize="@dimen/_10sdp"
                android:textColor="#FFFFFF"
                android:layout_marginStart="@dimen/_2sdp"
                android:letterSpacing="0.05"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="(144 / 3197 МБ)"
                android:fontFamily="@font/ttnorms_bold"
                tools:ignore="SpUsage" />

            <TextView
                android:id="@+id/proc"
                android:textSize="@dimen/_10sdp"
                android:textColor="#FFFFFF"
                android:letterSpacing="0.035"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="5%"
                android:gravity="end"
                android:fontFamily="@font/ttnorms_bold"
                tools:ignore="SpUsage" />

        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_4sdp"
            style="?android:progressBarStyleHorizontal"
            android:max="1000"
            android:progress="800"
            android:progressDrawable="@drawable/progressload" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/mainscreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

</FrameLayout>