<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC000000">

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/ic_dialog_newlauncher_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/_18sdp"
            android:layout_marginTop="@dimen/_18sdp"
            android:layout_marginBottom="@dimen/_18sdp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/btn_back"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginRight="@dimen/_21sdp"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="@dimen/_28sdp"
                    android:layout_height="@dimen/_28sdp"
                    android:background="@drawable/ic_dialog_back"
                    android:backgroundTint="#333439"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="@dimen/_11sdp"
                        android:layout_height="@dimen/_11sdp"
                        android:src="@drawable/ic_back"
                        android:layout_gravity="center" />

                </FrameLayout>

                <TextView
                    android:id="@+id/bigText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/_9sdp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="@dimen/_1sdp"
                    android:text="Управление аккаунтом"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_14sdp"
                    android:letterSpacing="0.02"
                    android:fontFamily="@font/geologica_semibold" />
            </LinearLayout>


            <LinearLayout
                android:id="@+id/btn_delete"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_26sdp"
                android:layout_marginBottom="@dimen/_7sdp"
                android:layout_marginRight="@dimen/_17sdp"
                android:background="@drawable/ic_btn_dark"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="@dimen/_11sdp"
                android:visibility="visible">

                <ImageView
                    android:layout_width="@dimen/_9sdp"
                    android:layout_height="@dimen/_9sdp"
                    android:layout_gravity="center"
                    android:layout_marginEnd="@dimen/_4sdp"
                    app:srcCompat="@drawable/ic_trash" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:fontFamily="@font/geologica_light"
                    android:layout_marginBottom="@dimen/_1sdp"
                    android:text="Удалить аккаунт"
                    android:letterSpacing="0.01"
                    android:textColor="#ffffff"
                    android:textSize="@dimen/_8sdp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_exit"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_26sdp"
                android:layout_marginRight="@dimen/_17sdp"
                android:background="@drawable/ic_btn_dark"
                android:orientation="horizontal"
                android:gravity="center"
                android:visibility="visible">

                <ImageView
                    android:layout_width="@dimen/_9sdp"
                    android:layout_height="@dimen/_9sdp"
                    android:layout_gravity="center"
                    android:layout_marginEnd="@dimen/_4sdp"
                    app:srcCompat="@drawable/ic_logout" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:fontFamily="@font/geologica_light"
                    android:layout_marginBottom="@dimen/_1sdp"
                    android:text="Выйти"
                    android:textColor="#ffffff"
                    android:textSize="@dimen/_8sdp" />
            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>