<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:id="@+id/main_fl_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <SurfaceView
        android:id="@+id/main_sv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible" />

    <FrameLayout
        android:id="@+id/head_ui_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:id="@+id/back_ui_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <View
            android:id="@+id/dark_screen"
            android:background="#00000000"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"/>

        <FrameLayout
            android:id="@+id/front_ui_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

            <include layout="@layout/noty" />

    </FrameLayout >

    <ru.edgar.nlremake.ui.FullHeightVideoView
        android:id="@+id/videoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <LinearLayout
        android:id="@+id/progressBar"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_17sdp">

        <TextView
            android:id="@+id/lm_status"
            android:textSize="@dimen/_10sdp"
            android:textColor="#ffffffff"
            android:gravity="right"
            android:layout_gravity="center_vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_15sdp"
            android:text="Загрузка игры..."
            android:layout_weight="1.0"
            android:fontFamily="@font/ttnorms_medium"/>

        <ru.edgar.nlremake.ui.CircularSegmentProgressBar
            android:layout_gravity="center"
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:layout_marginEnd="16dp"
            android:indeterminate="true"/>
    </LinearLayout>

</FrameLayout>
