<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <View
        android:id="@+id/overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_overlay_profile"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/btn_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/_15sdp"
        android:layout_marginStart="@dimen/_58sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:layout_width="@dimen/_29sdp"
            android:layout_height="@dimen/_29sdp"
            android:background="@drawable/ic_dialog_back">

            <ImageView
                android:layout_width="@dimen/_12sdp"
                android:layout_height="@dimen/_12sdp"
                android:src="@drawable/ic_back"
                android:layout_gravity="center" />

        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_10sdp"
            android:layout_marginBottom="@dimen/_2sdp"
            android:alpha="0.4"
            android:layout_gravity="center"
            android:text="Профиль"
            android:textColor="@color/white"
            android:textSize="@dimen/_14sdp"
            android:fontFamily="@font/geologica_semibold" />

    </LinearLayout>

    <ImageView
        android:id="@+id/imageView3"
        android:layout_width="@dimen/_9sdp"
        android:layout_height="@dimen/_9sdp"
        android:layout_marginRight="@dimen/_3sdp"
        app:layout_constraintBottom_toBottomOf="@+id/btn_balance"
        app:layout_constraintEnd_toStartOf="@+id/tv_balance"
        app:layout_constraintTop_toTopOf="@+id/btn_balance"
        app:srcCompat="@drawable/ic_rub" />

    <TextView
        android:id="@+id/tv_balance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/_8sdp"
        android:layout_marginBottom="@dimen/_2sdp"
        android:fontFamily="@font/geologica_semibold"
        android:text="2 610 709 168"
        android:letterSpacing="0.05"
        android:textColor="#ffffff"
        android:textSize="@dimen/_10sdp"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="@+id/btn_balance"
        app:layout_constraintEnd_toStartOf="@+id/btn_balance"
        app:layout_constraintTop_toTopOf="@+id/btn_balance" />


    <FrameLayout
        android:id="@+id/btn_balance"
        android:layout_width="@dimen/_28sdp"
        android:layout_height="@dimen/_28sdp"
        android:layout_marginEnd="@dimen/_18sdp"
        android:visibility="visible"
        android:background="@drawable/ic_circle_bg_dark"
        app:layout_constraintBottom_toBottomOf="@+id/btn_back"
        app:layout_constraintEnd_toStartOf="@+id/mcoin"
        app:layout_constraintTop_toTopOf="@+id/btn_back">

        <ImageView
            android:layout_width="@dimen/_12sdp"
            android:layout_height="@dimen/_12sdp"
            android:layout_gravity="center"
            android:alpha="0.6"
            app:srcCompat="@drawable/ic_exchange" />
    </FrameLayout>

    <ImageView
        android:id="@+id/mcoin"
        android:layout_width="@dimen/_20sdp"
        android:layout_height="@dimen/_19sdp"
        android:layout_marginRight="@dimen/_4sdp"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="@+id/btn_donate"
        app:layout_constraintEnd_toStartOf="@+id/tv_donate"
        app:layout_constraintTop_toTopOf="@+id/btn_donate"
        app:srcCompat="@drawable/ic_mc" />

    <TextView
        android:id="@+id/tv_donate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/_7sdp"
        android:layout_marginBottom="@dimen/_2sdp"
        android:fontFamily="@font/geologica_semibold"
        android:text="5 093 007"
        android:textColor="#ffffff"
        android:letterSpacing="0.05"
        android:textSize="@dimen/_10sdp"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="@+id/btn_donate"
        app:layout_constraintEnd_toStartOf="@+id/btn_donate"
        app:layout_constraintTop_toTopOf="@+id/btn_donate" />

    <FrameLayout
        android:id="@+id/btn_donate"
        android:layout_width="@dimen/_28sdp"
        android:layout_height="@dimen/_28sdp"
        android:layout_marginEnd="@dimen/_24sdp"
        android:background="@drawable/ic_circle_bg_purple"
        app:layout_constraintBottom_toBottomOf="@+id/btn_balance"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btn_balance">

        <ImageView
            android:layout_width="@dimen/_12sdp"
            android:layout_height="@dimen/_12sdp"
            android:layout_gravity="center"
            app:srcCompat="@drawable/ic_plus" />
    </FrameLayout>


    <LinearLayout
        android:id="@+id/linearLayout4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_22sdp"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="@+id/btn_back"
        app:layout_constraintTop_toBottomOf="@+id/btn_back">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/nick_name_status"
                android:layout_width="@dimen/_12sdp"
                android:layout_height="@dimen/_12sdp"
                android:layout_gravity="center"
                android:src="@drawable/ic_nopremium" />

            <TextView
                android:id="@+id/nick_name_servers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center"
                android:layout_marginStart="@dimen/_3sdp"
                android:layout_marginBottom="@dimen/_2sdp"
                android:fontFamily="@font/geologica_semibold"
                android:letterSpacing="0.05"
                android:text="Edgar_Top"
                android:textColor="#ffffff"
                android:textSize="@dimen/_10sdp" />

            <TextView
                android:id="@+id/player_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center"
                android:layout_marginStart="@dimen/_4sdp"
                android:layout_marginBottom="@dimen/_2sdp"
                android:fontFamily="@font/geologica_semibold"
                android:text="3"
                android:textColor="#b797e0"
                android:textSize="@dimen/_10sdp" />

            <TextView
                android:id="@+id/exp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|top"
                android:layout_marginStart="@dimen/_18sdp"
                android:layout_marginBottom="@dimen/_2sdp"
                android:fontFamily="@font/geologica_medium"
                android:text="11"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_9sdp" />

            <TextView
                android:id="@+id/max_exp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|top"
                android:layout_marginBottom="@dimen/_2sdp"
                android:alpha="0.6"
                android:fontFamily="@font/geologica_medium"
                android:text="/ 16"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_9sdp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress"
            style="?android:progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_4sdp"
            android:layout_marginTop="@dimen/_1sdp"
            android:max="100"
            android:progress="60"
            android:progressDrawable="@drawable/progressexp" />

    </LinearLayout>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.45"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/profileStatsRecyclerView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_21sdp"
        app:layout_constraintStart_toStartOf="@+id/linearLayout4"
        app:layout_constraintEnd_toStartOf="@+id/guideline2"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout4"/>

    <LinearLayout
        android:id="@+id/btn_settings"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_26sdp"
        android:background="@drawable/ic_btn_dark"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_marginRight="@dimen/_24sdp"
        android:layout_marginBottom="@dimen/_14sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="@dimen/_9sdp"
            android:layout_height="@dimen/_9sdp"
            android:layout_marginEnd="@dimen/_4sdp"
            android:layout_marginStart="@dimen/_10sdp"
            app:srcCompat="@drawable/ic_settings" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/_10sdp"
            android:layout_marginBottom="@dimen/_1sdp"
            android:fontFamily="@font/geologica_medium"
            android:text="Управление аккаунтом"
            android:textColor="#ffffff"
            android:textSize="@dimen/_8sdp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/btn_payment"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_26sdp"
        android:background="@drawable/ic_btn_dark"
        android:gravity="center"
        android:orientation="horizontal"
        android:alpha="0.5"
        android:layout_marginRight="@dimen/_7sdp"
        app:layout_constraintBottom_toBottomOf="@+id/btn_settings"
        app:layout_constraintEnd_toStartOf="@+id/btn_settings">

        <ImageView
            android:layout_width="@dimen/_9sdp"
            android:layout_height="@dimen/_9sdp"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_marginEnd="@dimen/_4sdp"
            app:srcCompat="@drawable/ic_payment" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/_10sdp"
            android:layout_marginBottom="@dimen/_1sdp"
            android:fontFamily="@font/geologica_medium"
            android:text="Управление оплатой"
            android:textColor="#ffffff"
            android:textSize="@dimen/_8sdp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/btn_promo"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_26sdp"
        android:background="@drawable/ic_btn_dark"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_marginRight="@dimen/_8sdp"
        app:layout_constraintBottom_toBottomOf="@+id/btn_payment"
        app:layout_constraintEnd_toStartOf="@+id/btn_payment">

        <ImageView
            android:layout_width="@dimen/_9sdp"
            android:layout_height="@dimen/_9sdp"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_marginEnd="@dimen/_4sdp"
            app:srcCompat="@drawable/ic_promo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/_10sdp"
            android:layout_marginBottom="@dimen/_1sdp"
            android:fontFamily="@font/geologica_medium"
            android:text="Активировать промокод"
            android:textColor="#ffffff"
            android:textSize="@dimen/_8sdp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>