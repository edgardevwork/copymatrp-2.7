<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/menu_bg_shadow">

    <TextView
        android:id="@+id/uidtext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="getUid"
        android:textColor="@color/white"
        android:fontFamily="@font/montserrat_bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/nickName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/_15sdp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginTop="@dimen/_16sdp"
        android:letterSpacing="0.08"
        android:text="Edgar_Top"
        android:textColor="#ffffff"
        android:textSize="@dimen/_12sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/btn_settings"
        android:layout_width="@dimen/_28sdp"
        android:layout_height="@dimen/_28sdp"
        android:layout_marginEnd="@dimen/_15sdp"
        app:layout_constraintBottom_toBottomOf="@+id/nickName"
        app:layout_constraintEnd_toStartOf="@+id/nickName"
        app:layout_constraintTop_toTopOf="@+id/nickName">

        <ImageView
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_28sdp"
            android:background="@drawable/ic_circle_bg_dark"
            tools:ignore="MissingConstraints" />

        <ImageView
            android:layout_width="@dimen/_12sdp"
            android:layout_height="@dimen/_12sdp"
            android:layout_gravity="center"
            android:src="@drawable/ic_settings" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/btn_balance"
        android:layout_width="@dimen/_28sdp"
        android:layout_height="@dimen/_28sdp"
        android:layout_marginEnd="@dimen/_15sdp"
        app:layout_constraintBottom_toBottomOf="@+id/btn_settings"
        app:layout_constraintEnd_toStartOf="@+id/btn_settings"
        app:layout_constraintTop_toTopOf="@+id/btn_settings">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:srcCompat="@drawable/ic_circle_bg_dark"
            tools:ignore="MissingConstraints" />

        <ImageView
            android:layout_width="@dimen/_14sdp"
            android:layout_height="@dimen/_14sdp"
            android:layout_gravity="center"
            app:srcCompat="@drawable/ic_balance_icon" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_balance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:fontFamily="@font/montserrat_bold"
        android:text="₽ 26 900"
        android:textColor="#ffffff"
        android:textSize="@dimen/_12sdp"
        app:layout_constraintBottom_toBottomOf="@+id/btn_balance"
        app:layout_constraintEnd_toStartOf="@+id/btn_balance"
        app:layout_constraintTop_toTopOf="@+id/btn_balance" />

    <FrameLayout
        android:id="@+id/btn_donate"
        android:layout_width="@dimen/_28sdp"
        android:layout_height="@dimen/_28sdp"
        android:layout_marginEnd="@dimen/_15sdp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_balance"
        app:layout_constraintEnd_toStartOf="@+id/tv_balance"
        app:layout_constraintTop_toTopOf="@+id/tv_balance">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:srcCompat="@drawable/ic_circle_bg_purple"
            tools:ignore="MissingConstraints" />

        <ImageView
            android:layout_width="22dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:srcCompat="@drawable/ic_sc" />
    </FrameLayout>

    <!-- Новости заголовок -->
    <TextView
        android:id="@+id/tv_donate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserrat_bold"
        android:text="SC 15"
        android:textColor="#ffffff"
        android:textSize="@dimen/_12sdp"
        android:layout_marginRight="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/btn_donate"
        app:layout_constraintEnd_toStartOf="@+id/btn_donate"
        app:layout_constraintTop_toTopOf="@+id/btn_donate"/>

    <FrameLayout
        android:id="@+id/btn_play"
        android:layout_width="@dimen/_136sdp"
        android:layout_height="@dimen/_54sdp"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="@dimen/_16sdp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/imageView32"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:srcCompat="@drawable/ic_launcher_play_bg" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imageView299"
                android:layout_width="@dimen/_15sdp"
                android:layout_height="@dimen/_18sdp"
                android:layout_gravity="center_vertical"
                android:scaleType="fitXY"
                app:srcCompat="@drawable/ic_launcher_play" />

            <TextView
                android:id="@+id/textView493"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/_7sdp"
                android:fontFamily="@font/ttnorms_medium"
                android:text="Играть"
                android:textColor="#ffffff"
                android:textSize="@dimen/_14sdp" />
        </LinearLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>