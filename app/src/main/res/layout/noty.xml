<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="wrap_content"
	android:layout_height="wrap_content"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:background="@drawable/ic_btn_dark"
	android:paddingLeft="@dimen/_14sdp"
	android:paddingRight="@dimen/_14sdp"
	android:paddingTop="@dimen/_8sdp"
	android:paddingBottom="@dimen/_8sdp">

	<!-- Контейнер для иконки (i или треугольник) -->
	<FrameLayout
		android:id="@+id/iconContainer"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:background="@drawable/ic_dialog_nl_input_bg_error"
		android:padding="@dimen/_6sdp"
		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toTopOf="parent">

		<ImageView
			android:id="@+id/notificationIcon"
			android:layout_width="@dimen/_14sdp"
			android:layout_height="@dimen/_14sdp"
			android:layout_gravity="center"
			android:src="@drawable/ic_nopremium" />
	</FrameLayout>

	<!-- Текст уведомления -->
	<TextView
		android:id="@+id/notificationText"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginLeft="@dimen/_10sdp"
		android:text="Чтобы продолжить, прими пользовательское соглашение и политику конфиденциальности"
		android:textColor="@color/white"
		android:textSize="@dimen/_11sdp"
		android:gravity="left|center_vertical"
		app:layout_constrainedWidth="true"
		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintStart_toEndOf="@id/iconContainer"
		app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
